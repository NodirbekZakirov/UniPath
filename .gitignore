# Исключаем автоматически созданный байткод Python.
__pycache__/
# Исключаем скомпилированные файлы Python.
*.py[cod]
# Исключаем локальное виртуальное окружение.
.venv/
# Не публикуем личные данные и хеши паролей пользователей в репозитории.
db.sqlite3
# Не публикуем секретные настройки.
.env
# Исключаем локальные резервные копии базы пользователей.
db.sqlite3.*
